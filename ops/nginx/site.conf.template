server {
  listen 80;
  server_name ${PROPCOMPARE_DOMAIN};
  location /.well-known/acme-challenge/ { root /var/www/certbot; }
  location / { return 301 https://$host$request_uri; }
}

server {
  listen 443 ssl http2;
  server_name ${PROPCOMPARE_DOMAIN};
  ssl_certificate /etc/letsencrypt/live/${PROPCOMPARE_DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${PROPCOMPARE_DOMAIN}/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_session_cache shared:SSL:10m;

  location / {
    limit_req zone=public_api burst=60 nodelay;
    proxy_pass http://propcompare_web;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Request-ID $request_id;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Connection "";
    proxy_read_timeout 60s;
  }
}
