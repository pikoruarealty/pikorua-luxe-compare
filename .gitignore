# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
.output
.vinxi
.tanstack/**
.nitro
*.local

# This project uses Bun (bun.lock is the source of truth) — don't commit other
# package managers' lockfiles.
package-lock.json
yarn.lock
pnpm-lock.yaml

# Wrangler / Cloudflare
.wrangler/
.dev.vars

# Vercel
.vercel

# Secrets — .env.example stays committed as the template
.env
.env.*
!.env.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# The OCR service lives on the `ocr-service` branch and is deployed to its own
# host (Render/Railway) — it is Python and cannot run on Vercel. It stays here
# on disk so it can be run locally, but must not be committed to main.
/property-ocr-suite/
