# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
.output
.vinxi
.tanstack/**
.nitro
*.local

# This project uses Bun (bun.lock is the source of truth) — don't commit other
# package managers' lockfiles.
package-lock.json
yarn.lock
pnpm-lock.yaml

# Wrangler / Cloudflare
.wrangler/
.dev.vars

# Vercel
.vercel

# Secrets — .env.example stays committed as the template
.env
.env.*
!.env.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# The OCR service under property-ocr-suite/ keeps its own .gitignore for the
# Python-specific entries (venv, __pycache__, runtime storage).
