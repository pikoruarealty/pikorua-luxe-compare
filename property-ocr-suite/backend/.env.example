# Copy this file to .env and fill in your real values.
# Never commit .env to git, never paste keys into chat.

# Pick ONE provider. "openai" or "anthropic".
LLM_PROVIDER=openai

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini
# Only needed if OPENAI_API_KEY is for an OpenAI-compatible gateway
# (e.g. OpenRouter) instead of api.openai.com directly.
OPENAI_BASE_URL=

ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# Shared secret between this service and the developer portal that
# calls it. Set this to any long random string and give the same
# value to whoever integrates with the API (BROCHURE_EXTRACTOR_API_KEY
# in the website's .env — the two must match).
#
# The service refuses to start if this is empty. That is deliberate: it
# used to start anyway and serve every endpoint unauthenticated, so one
# forgotten variable was the difference between private and public.
SERVICE_API_KEY=change-me

# Set to 1 to run with no key at all. Local development only — it opens
# the upload endpoint, the job reads and the extracted images to anyone
# who can reach the port, and it says so loudly in the log at startup.
ALLOW_INSECURE_LOCAL=

# Browser origins allowed to call this service. The upload really is
# cross-origin: brochures go from the browser straight here, because the
# website's host caps request bodies far below what a brochure weighs.
# Comma-separated. Add your deployed site origin in production.
ALLOWED_ORIGINS=http://localhost:5173

# Upload limits. MAX_PAGES_PER_DOC caps pages within one document; these
# two cap the request itself, so one call cannot fan out into hundreds of
# billed vision-LLM calls or fill the disk.
MAX_FILE_MB=40
MAX_FILES=6

# Tuning (safe to leave as-is)
MAX_PAGES_PER_DOC=40
PAGES_PER_LLM_CALL=3
# How many page-batches run in parallel per file. Raising this speeds up
# extraction but sends more concurrent requests to the LLM provider —
# stay mindful of rate limits if you raise it much past 4-6.
MAX_CONCURRENT_BATCHES=4
PAGE_RENDER_DPI=150
CONFIDENCE_FLOOR=0.55
