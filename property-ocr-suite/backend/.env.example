# Copy this file to .env and fill in your real values.
# Never commit .env to git, never paste keys into chat.

# Pick ONE provider. "openai" or "anthropic".
LLM_PROVIDER=openai

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini
# Only needed if OPENAI_API_KEY is for an OpenAI-compatible gateway
# (e.g. OpenRouter) instead of api.openai.com directly.
OPENAI_BASE_URL=

ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# Shared secret between this service and the developer portal that
# calls it. Set this to any long random string and give the same
# value to whoever integrates with the API.
SERVICE_API_KEY=change-me

# Tuning (safe to leave as-is)
MAX_PAGES_PER_DOC=40
PAGES_PER_LLM_CALL=3
PAGE_RENDER_DPI=150
CONFIDENCE_FLOOR=0.55
