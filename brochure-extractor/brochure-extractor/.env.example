# ---- required
OPENAI_API_KEY=sk-your-key-here

# ---- model (gpt-4.1-mini is the cost/accuracy sweet spot; gpt-4o for hard scans)
EXTRACTOR_MODEL=gpt-4.1-mini
IMAGE_TAG_MODEL=gpt-4.1-mini
MAX_OUTPUT_TOKENS=8000
REQUEST_TIMEOUT=180
MAX_RETRIES=3

# ---- pdf handling
RENDER_DPI=150
PAGES_PER_CHUNK=6
MAX_PAGES_PER_FILE=60
MAX_FILE_MB=40
SCANNED_TEXT_THRESHOLD=120
USE_TESSERACT=true

# ---- behaviour
PARALLEL_CHUNKS=4
MIN_CONFIDENCE=0.35
EXTRACT_IMAGES=true
MIN_IMAGE_PX=600
IMAGE_OUT_DIR=./extracted_images

# ---- service
SERVICE_API_KEY=change-me-shared-secret
ALLOWED_ORIGINS=http://localhost:3000,https://your-portal.com
PUBLIC_IMAGE_BASE=/images
LOG_LEVEL=INFO
