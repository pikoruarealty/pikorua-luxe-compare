# Copy this file to `.env` and fill in real values, then restart `npm run dev`.
# (Lovable Cloud used to inject these automatically; now they live here.)

# --- Supabase (server-side) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Supabase (client-side; Vite exposes only VITE_-prefixed vars to the browser) ---
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# --- Session cookies / signed OTP verification tokens (any long random string) ---
SESSION_SECRET=generate-a-long-random-secret

# --- Rate limiting (Upstash Redis, REST API) ---
# Backs the shared limiter on OTP sends, code guesses, account lookups and
# activity writes. Create a database at console.upstash.com and copy the REST
# credentials. Chosen over a platform-native store because it is plain HTTPS,
# so the same code works on Vercel today and on the GCP VM later.
UPSTASH_REDIS_REST_URL=https://YOUR-DB.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# --- Phone OTP delivery via 2Factor.in ---
TWO_FACTOR_API_KEY=your-2factor-api-key

# --- Brochure OCR service (developer portal's "upload brochure" option) ---
# Run property-ocr-suite/backend (see its README) and point these at it.
# Leave BROCHURE_EXTRACTOR_URL unset to disable OCR — manual entry still works.
BROCHURE_EXTRACTOR_URL=http://localhost:8000
BROCHURE_EXTRACTOR_API_KEY=match-the-extractor-services-SERVICE_API_KEY

# --- Brevo (transactional email for the sign-up email OTP) ---
# Sender must be a verified sender/domain in your Brevo account.
BREVO_API_KEY=xkeysib-your-key-here
BREVO_SENDER_EMAIL=you@yourdomain.com
BREVO_SENDER_NAME=PropCompare

# --- Google Sign-In ---
# Client ID is public (ships in the browser); the secret must stay server-side.
VITE_GOOGLE_CLIENT_ID=your-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-secret-here
